{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase",
        "--read-only",
        "--project-ref",
        "rsxfmokwmwujercgpnfu"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    },
    "gsc": {
      "command": "/usr/local/bin/node",
      "args": [
        "node_modules/mcp-server-gsc/dist/index.js"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${HOME}/.config/busmoov/gsc-service-account.json"
      }
    }
  }
}
