{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase",
        "--read-only",
        "--project-ref",
        "rsxfmokwmwujercgpnfu"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    },
    "gsc": {
      "command": "npx",
      "args": ["-y", "mcp-server-gsc@0.3.0"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GSC_SERVICE_ACCOUNT_FILE}"
      }
    }
  }
}
