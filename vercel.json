{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "busmoov.com"
        }
      ],
      "destination": "https://www.busmoov.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^es.*"
        }
      ],
      "destination": "/es",
      "statusCode": 302
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^de.*"
        }
      ],
      "destination": "/de",
      "statusCode": 302
    },
